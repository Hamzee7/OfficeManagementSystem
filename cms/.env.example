# Copy to .env and edit. Never commit real secrets.
DATABASE_PATH=./data/cms.db
STORAGE_DIR=./storage
# Long random string used to sign cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
# Public base URL (used in emails and the same-origin check)
APP_URL=http://localhost:3000

# Email (optional). If SMTP_HOST is empty, emails are written to the outbox and logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=complaints@example.com

# SMS (optional). Not implemented yet: the adapter interface exists but no provider is wired.
SMS_PROVIDER=

# AI assistance (optional). "local" uses built-in rule-based suggestions that never leave the server.
AI_PROVIDER=local
